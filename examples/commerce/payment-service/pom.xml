<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.stateverdict</groupId>
        <artifactId>stateverdict-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>payment-service</artifactId>
    <name>Commerce example: payment service</name>

    <dependencies>
        <dependency>
            <groupId>dev.stateverdict</groupId>
            <artifactId>stateverdict-dispatch-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Mutation testing (docs/evaluation/mutation.md): mvn -Pmutation test-compile pitest:mutationCoverage
            Mutates the business logic of the production configuration only. Not mutated: the
            deliberately broken variants and evaluation switches (the defect corpus), the read-only
            state endpoints StateVerdict uses as evidence, configuration and plain records.
            +EXPORT writes every mutant's bytecode, so the same mutants can be deployed and run
            against StateVerdict.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>dev.stateverdict.examples.payment.IdempotentCaptureHandler</param>
                                <param>dev.stateverdict.examples.payment.PaymentDecision</param>
                                <param>dev.stateverdict.examples.payment.CaptureRepository</param>
                                <param>dev.stateverdict.examples.payment.RefundRepository</param>
                                <param>dev.stateverdict.examples.payment.PaymentRequestedListener</param>
                                <param>dev.stateverdict.examples.payment.RefundRequestedListener</param>
                                <param>dev.stateverdict.examples.payment.PaymentEventsPublisher</param>
                            </targetClasses>
                            <targetTests>
                                <param>dev.stateverdict.examples.payment.*</param>
                            </targetTests>
                            <excludedMethods>
                                <param>captureWithoutAtomicClaim</param>
                                <param>slowDown</param>
                                <param>findByOrderId</param>
                            </excludedMethods>
                            <avoidCallsTo>
                                <param>dev.stateverdict.examples.payment.Mutations</param>
                                <param>org.slf4j</param>
                            </avoidCallsTo>
                            <features>
                                <feature>+EXPORT</feature>
                            </features>
                            <outputFormats>
                                <param>XML</param>
                                <param>HTML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <threads>2</threads>
                            <!-- Each fresh PIT JVM restarts Spring and the test containers (tens of seconds) before its
                                 first test; a shorter limit turns that start-up into false TIMED_OUT results. -->
                            <timeoutConstant>180000</timeoutConstant>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
